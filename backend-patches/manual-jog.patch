new file mode 100644
index 00000000..e6dc9921
--- /dev/null
+++ b/application/backend/src/runtime_session/jog.py
@@ -0,0 +1,41 @@
+"""Bounded SO-101 jogging in the existing session's calibrated normalized space."""
+import math
+
+import numpy as np
+
+from runtime_session.store import Sample
+from schemas.runtime_session import JogJointCommand
+
+
+def jog_target(state: Sample | None, action: Sample | None, command: JogJointCommand,
+               *, now: float, last_jog: float, calibration: object) -> np.ndarray:
+    if state is None or action is None or not 0 <= now - state.timestamp <= 0.5:
+        raise ValueError("Fresh follower feedback is required.")
+    if not -0.3 <= now - command.observed_at <= 1.0:
+        raise ValueError("Dashboard feedback is stale; release and try again.")
+    if now - last_jog < 0.35:
+        raise ValueError("Jog rate exceeded; release and try again.")
+    if command.joint not in state.names or state.names != action.names:
+        raise ValueError("Unknown joint or mismatched feedback.")
+    if not isinstance(calibration, dict):
+        raise ValueError("Saved calibration is required.")
+    if not np.isfinite(state.value).all() or not np.isfinite(action.value).all():
+        raise ValueError("Invalid joint feedback.")
+    for i, name in enumerate(state.names):
+        joint = name.removesuffix(".pos")
+        cal = calibration.get(joint)
+        if not isinstance(cal, dict) or not 0 <= cal.get("range_min", -1) < cal.get("range_max", -1) <= 4095:
+            raise ValueError("Invalid joint calibration.")
+        low = 0 if joint == "gripper" else -100
+        if not low <= state.value[i] <= 100 or not low <= action.value[i] <= 100:
+            raise ValueError("Joint is outside its calibrated range.")
+    if np.max(np.abs(action.value - state.value)) > 2:
+        raise ValueError("Follower has not reached its target; release and try again.")
+    index = state.names.index(command.joint)
+    target = action.value.copy()
+    low = 0 if command.joint == "gripper.pos" else -100
+    value = float(state.value[index]) + command.delta
+    if not math.isfinite(value) or not low <= value <= 100:
+        raise ValueError("Calibrated joint limit reached.")
+    target[index] = value
+    return target
diff --git a/application/backend/tests/runtime_session/test_jog.py b/application/backend/tests/runtime_session/test_jog.py
new file mode 100644
index 00000000..9a41cc8e
--- /dev/null
+++ b/application/backend/tests/runtime_session/test_jog.py
@@ -0,0 +1,35 @@
+import numpy as np
+import pytest
+from pydantic import ValidationError
+
+from runtime_session.jog import jog_target
+from runtime_session.store import Sample
+from schemas.runtime_session import JogJointCommand
+
+
+def call(*, state_at=10, observed_at=10, last_jog=0, joint='wrist_roll.pos', delta=0.5, position=0):
+    names = ('wrist_roll.pos', 'gripper.pos')
+    state = Sample(np.array([position, 50.0]), names, state_at)
+    action = Sample(np.array([position, 50.0]), names, 10)
+    command = JogJointCommand(request_id='test', joint=joint, delta=delta, observed_at=observed_at)
+    cal = {name.removesuffix('.pos'): {'range_min': 100, 'range_max': 3900} for name in names}
+    return jog_target(state, action, command, now=10, last_jog=last_jog, calibration=cal)
+
+
+def test_moves_only_requested_joint():
+    assert call().tolist() == [0.5, 50.0]
+
+
+@pytest.mark.parametrize('kwargs', [
+    {'state_at': 9}, {'observed_at': 8}, {'observed_at': 11}, {'last_jog': 9.9},
+    {'joint': 'missing'}, {'position': 100}, {'position': -101}, {'position': float('nan')},
+])
+def test_rejects_unsafe_or_stale_commands(kwargs):
+    with pytest.raises(ValueError):
+        call(**kwargs)
+
+
+@pytest.mark.parametrize('delta', [1, -1, float('nan'), float('inf')])
+def test_rejects_large_or_invalid_steps(delta):
+    with pytest.raises(ValidationError):
+        call(delta=delta)
